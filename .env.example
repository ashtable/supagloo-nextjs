# supagloo-nextjs — local dev + e2e env template.
#
#   cp .env.example .env.local   # then fill in the real values (gitignored)
#
# Next.js loads .env.local for `next dev` automatically; the Vitest e2e harness
# loads it explicitly (tests/e2e/load-env.ts, tests/e2e/global-setup.ts).

# ============================================================================
# Gloo AI — TWO DISTINCT credential sets (design-delta §10.8, task 34-E2).
# These two collide by concept but MUST use different env var names here.
# ============================================================================

# --- (1) Stagehand's OWN LLM (the e2e test-harness AI that drives the browser) ---
# Read by lib/gloo/llm-client.ts to mint a Gloo OAuth token + pick the model for
# Stagehand's extract/observe. This is the HARNESS's brain — unrelated to the app's
# per-user Gloo connections. Required by the nextjs e2e harness (fail-fast, not skip).
GLOO_STAGEHAND_MODEL=gloo-openai-gpt-5-mini
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=

# --- (2) The APP-UNDER-TEST's Gloo connect credentials ---
# REQUIRED by the real lane. `tests/e2e/openrouter-gloo-connect.e2e.ts` (E-C3) types
# these into the app's "Connect Gloo" form (PUT /api/connect/gloo → the API's LIVE
# client-credentials verify-then-store), and E-C4 asserts the profile page renders the
# stored client id back. They must therefore be credentials REAL Gloo accepts: the spec
# used to use the deleted gloo-stub's `gloo-e2e-client`/`gloo-e2e-secret` fixtures,
# which real Gloo rejects. The spec now reads these two names and FAILS FAST (never
# skips, never falls back) when either is unset — design-delta §10.8.
#
# Deliberately DISTINCT names so they never clobber Stagehand's own LLM creds above
# (task 34-E2): in THIS repo plain GLOO_CLIENT_ID/GLOO_CLIENT_SECRET already mean the
# harness's brain. In supagloo-nodejs-api / -dbos this same app-side concept is just
# GLOO_CLIENT_ID/SECRET (no Stagehand there to collide with) — the GLOO_CONNECT_ prefix
# is nextjs-only. The real values are the ROOT supagloo checkout's `.env`
# GLOO_CLIENT_ID/GLOO_CLIENT_SECRET; copy them across into your untracked `.env.local`
# under these names. Never put a value in this tracked file.
GLOO_CONNECT_CLIENT_ID=
GLOO_CONNECT_CLIENT_SECRET=

# ============================================================================
# App server env
# ============================================================================

# YouVersion Platform API key. nextjs uses the shorter name YV_APP_KEY (a
# pre-existing divergence from the backends' YOUVERSION_APP_KEY). The ONLY variable this
# app REQUIRES at boot: task 43 (D43.2) added `instrumentation.ts`, whose `register()`
# runs `lib/config/env.ts`'s validator before Next can serve anything, so a missing or
# empty value now REFUSES TO BOOT rather than 500ing every page. Empty counts as unset
# (that is what `docker compose`'s ${VAR:-} substitution yields). In Compose it arrives as
# a RUNTIME env on the nextjs service, substituted from the root .env's YOUVERSION_APP_KEY.
YV_APP_KEY=

# ---------------------------------------------------------------------------
# SECRETS_ENCRYPTION_KEY — task 43: this app must NEVER hold it.
# ---------------------------------------------------------------------------
# Deliberately absent from this file, and deliberately NOT a variable you may add.
# supagloo-nextjs has no database and no S3 access and never calls encryptSecret /
# decryptSecret (design-delta §5.1); the application secrets key belongs to
# supagloo-nodejs-api and supagloo-nodejs-dbos, which must carry the SAME value as each
# other within one environment and a DISTINCT one per environment. plan row 43's
# "all three services validate the key" line is stale for this repo (Step-5 finding S4) —
# the nextjs check is the inversion: `lib/config/env.ts` refuses to boot if the variable
# is present at all, even with a perfectly valid 64-hex value.

# YouVersion sign-in redirect target (public — reaches the browser bundle).
NEXT_PUBLIC_YV_AUTH_REDIRECT_URL=http://localhost:3000

# Flag-gated mock-session reachability seam (plan D-AUTH). Dev + E2E only; MUST be
# absent/unset in prod so `?mock=` is a no-op there.
NEXT_PUBLIC_SUPAGLOO_DEMO=1

# The supagloo-nodejs-api base URL the BFF route handlers proxy to (server-side only;
# defaults to http://localhost:4000 when unset).
SUPAGLOO_API_URL=http://localhost:4000

# The extended Stagehand seed seam's server gate. `POST /api/test/seed` is a HARD 404
# unless this equals '1' AND NODE_ENV!=='production'. Dev + E2E only; unset in prod.
SUPAGLOO_ENABLE_TEST_SEED=1

# ============================================================================
# AI generation model/provider overrides (ALL OPTIONAL — task 57 item 2)
# ============================================================================
# The studio client never picks a model/provider; the BFF route
# (app/api/ai/generations/route.ts) enriches each POST via resolveGenerationTarget
# (lib/api/ai-config.ts). Each kind falls back to a documented last-known-good
# OpenRouter model id (and provider=openrouter) unless the matching var below is set.
# resolveGenerationTarget logs which path (override vs. fallback) it used, prefixed
# `[supagloo:ai-config]`. NOTE: this is the CURRENT model source — replacing it with a
# live discovery endpoint (task 29 integration) is future work, out of scope here.
#
# Per-kind model override (openrouter model id). Unset → the built-in fallback:
# SUPAGLOO_AI_MODEL_STORYBOARD=
# SUPAGLOO_AI_MODEL_SCRIPT=
# SUPAGLOO_AI_MODEL_IMAGE=
# SUPAGLOO_AI_MODEL_NARRATION=
# SUPAGLOO_AI_MODEL_MUSIC=
# SUPAGLOO_AI_MODEL_VIDEO=
#
# Per-kind provider override (openrouter | gloo). Unset → openrouter (matrix-valid
# for every kind; image/narration/music/video are openrouter-only):
# SUPAGLOO_AI_PROVIDER_STORYBOARD=
# SUPAGLOO_AI_PROVIDER_SCRIPT=
# SUPAGLOO_AI_PROVIDER_IMAGE=
# SUPAGLOO_AI_PROVIDER_NARRATION=
# SUPAGLOO_AI_PROVIDER_MUSIC=
# SUPAGLOO_AI_PROVIDER_VIDEO=

# ============================================================================
# Optional e2e knobs (safe to omit)
# ============================================================================

# OpenRouter host for the browser PKCE leg (openrouter-connect.ts). Optional —
# defaults to https://openrouter.ai. The e2e specs shim OpenRouter's interactive
# browser login (design-delta §10.4a/§10.2) — the consent screen and the cross-origin
# token exchange only — but the key that shim hands back is REAL. See
# OPENROUTER_E2E_TEST_API_KEY in the root-.env section at the bottom of this file.
# NEXT_PUBLIC_OPENROUTER_BASE_URL=https://openrouter.ai

# ============================================================================
# The real + heavy-render e2e lanes read the ROOT repo's .env, not this file
# ============================================================================
# `npm run test:e2e:real` and `npm run test:e2e:render` drive real github.com, so they
# need the GitHub App credentials plus a user-scoped PAT to create the throwaway
# fixture repos — and the real lane's generation specs additionally need a real
# OpenRouter key. Those live in the UNTRACKED `.env` of the ROOT supagloo checkout —
# the single credential source for every lane in every repo — and are loaded into each
# Vitest worker by `tests/e2e/load-root-env.ts`. They are deliberately NOT duplicated
# here, and no value of any of them belongs in a tracked file.
#
# Variable NAMES only, for reference (documented with guidance in the ROOT .env.example):
#   GITHUB_APP_ID, GITHUB_APP_SLUG, GITHUB_APP_PRIVATE_KEY   — the App identity
#   GITHUB_E2E_PAT_TOKEN                                     — host-side only; creates
#                                                              fixture repos. NEVER
#                                                              passed into a container.
#   SUPAGLOO_E2E_GITHUB_OWNER                                — optional; only needed
#                                                              when the App has more
#                                                              than one installation.
#   OPENROUTER_E2E_TEST_API_KEY                              — the REAL key the
#                                                              intercepted PKCE exchange
#                                                              returns, so a "connected"
#                                                              provider can actually
#                                                              authenticate. Required by
#                                                              every real-lane spec that
#                                                              performs a generation
#                                                              (studio-ai-generation,
#                                                              studio-replan-scripture)
#                                                              and by
#                                                              openrouter-gloo-connect.
#                                                              Fail-fast, never a fake
#                                                              fallback — a stored key
#                                                              real OpenRouter 401s
#                                                              fails far from its cause.
#                                                              NOT needed by the
#                                                              zero-egress render lane.
# The installation id is DISCOVERED at runtime (GET /app/installations) and is never
# configured anywhere.
#
# Point the harness at a root checkout that is not `../supagloo`:
# SUPAGLOO_ROOT_DIR=/absolute/path/to/supagloo
#
# The MOCK lane (`npm run test:e2e`) needs none of the above: no Docker, no root .env,
# no network egress. Keep it that way.
